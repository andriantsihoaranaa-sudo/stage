                                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Statut de validation :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheStatutValidation" text="VALIDE" styleClass="fiche-field-val" style="-fx-text-fill: #15803d; -fx-font-weight: bold;" />
                                    </VBox>

                                    <VBox spacing="2" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                        <Label text="Mentions marginales :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheObservations" text="Néant" styleClass="fiche-field-val" />
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <!-- Bloc 4 : Document Délivré -->
                            <VBox spacing="8" styleClass="fiche-section-box">
                                <Label text="IV. DOCUMENT DÉLIVRÉ ET SUIVI DE REMISE" styleClass="fiche-section-header" />
                                <GridPane hgap="16" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="33" />
                                        <ColumnConstraints percentWidth="33" />
                                        <ColumnConstraints percentWidth="34" />
                                    </columnConstraints>

                                    <VBox spacing="2" GridPane.columnIndex="0">
                                        <Label text="Type de document délivré :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheTypeDoc" text="Extrait d'acte de naissance" styleClass="fiche-field-val" />
                                    </VBox>

                                    <VBox spacing="2" GridPane.columnIndex="1">
                                        <Label text="Numéro de document :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheNumDoc" text="DOC-2025-001" styleClass="fiche-field-val" />
                                    </VBox>

                                    <VBox spacing="2" GridPane.columnIndex="2">
                                        <Label text="Délivré le :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheDateDoc" text="16/01/2025 à 10:00" styleClass="fiche-field-val" />
                                    </VBox>

                                    <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Réceptionné par :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheReceptionnaire" text="KOUASSI Jean-Baptiste" styleClass="fiche-field-val" />
                                    </VBox>

                                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Confirmation de remise :" styleClass="fiche-field-name" />
                                        <Label fx:id="lblFicheRemiseConfirmation" text="✓ Confirmée en main propre" styleClass="fiche-field-val" style="-fx-text-fill: #15803d;" />
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <!-- Pied de la fiche officielle -->
                            <HBox alignment="CENTER_BETWEEN" spacing="20" style="-fx-padding: 10 0 0 0;">
                                <VBox spacing="2">
                                    <Label text="Sceau de la Mairie / Centre d'État Civil :" styleClass="fiche-field-name" />
                                    <Label text="[SCEAU OFFICIEL COMMUNAL ENREGISTRÉ]" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                                </VBox>
                                <VBox spacing="2" alignment="CENTER_RIGHT">
                                    <Label text="Signature de l'Officier d'État Civil :" styleClass="fiche-field-name" />
                                    <Label text="Certifié conforme aux registres de la commune" style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
                                </VBox>
                            </HBox>

                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ============================================================= -->
            <!-- 6. VUE : GESTION DES UTILISATEURS (ADMINISTRATEUR)             -->
            <!-- ============================================================= -->
            <VBox fx:id="viewUtilisateurs" spacing="16" visible="false" managed="false">
                <padding><Insets top="16" right="20" bottom="16" left="20" /></padding>

                <VBox spacing="2">
                    <Label text="Gestion des Utilisateurs et Droits d'Accès" styleClass="view-title" />
                    <Label text="Administration des comptes habilités au registre communal (Réservé au rôle ADMINISTRATEUR)" styleClass="view-subtitle" />
                </VBox>

                <!-- Formulaire création nouvel utilisateur -->
                <VBox spacing="12" styleClass="form-card">
                    <Label text="Créer un nouveau compte d'accès" styleClass="form-card-title" />
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="30" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="20" />
                        </columnConstraints>

                        <VBox spacing="4" GridPane.columnIndex="0">
                            <Label text="Nom d'utilisateur (login unique) :" styleClass="form-field-label" />
                            <TextField fx:id="txtNewUserLogin" promptText="Ex : agent.durand" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="1">
                            <Label text="Nom complet &amp; Prénoms :" styleClass="form-field-label" />
                            <TextField fx:id="txtNewUserNomComplet" promptText="Ex : DURAND Marc" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="2">
                            <Label text="Rôle attribué :" styleClass="form-field-label" />
                            <ComboBox fx:id="cbNewUserRole" maxWidth="Infinity" />
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="3">
                            <Label text="Mot de passe initial :" styleClass="form-field-label" />
                            <PasswordField fx:id="txtNewUserMdp" promptText="••••••••" />
                        </VBox>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="＋ Enregistrer le compte" onAction="#creerNouvelUtilisateur" styleClass="btn-primary" />
                    </HBox>
                </VBox>

                <!-- Tableau des utilisateurs -->
                <VBox spacing="8" VBox.hgrow="ALWAYS" styleClass="form-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Liste des comptes enregistrés dans SQLite" styleClass="form-card-title" HBox.hgrow="ALWAYS" />
                        <Button text="Activer / Désactiver le compte" onAction="#toggleActifUtilisateur" styleClass="btn-secondary" />
                        <Button text="⟳ Actualiser la liste" onAction="#afficherVueUtilisateurs" styleClass="btn-secondary" />
                    </HBox>

                    <TableView fx:id="tableUtilisateurs" VBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUserId" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colUserNom" text="Identifiant" prefWidth="120" />
                            <TableColumn fx:id="colUserNomComplet" text="Nom complet" prefWidth="200" />
                            <TableColumn fx:id="colUserRole" text="Rôle" prefWidth="170" />
                            <TableColumn fx:id="colUserActif" text="Statut" prefWidth="90" />
                            <TableColumn fx:id="colUserDateCreation" text="Date création" prefWidth="150" />
                            <TableColumn fx:id="colUserDerniereConnexion" text="Dernière connexion" prefWidth="160" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

        </StackPane>
    </center>

    <!-- ===================================================================== -->
    <!-- BARRE D'ÉTAT INFÉRIEURE                                               -->
    <!-- ===================================================================== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="status-bar">
            <Label fx:id="lblStatutDB" text="● Base SQLite connectée" styleClass="status-db" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="lblTotalActes" text="Total : 0 dossier(s)" styleClass="status-text" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="lblVueActuelle" text="Vue : Tableau de bord" styleClass="status-text" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="lblMessageInfo" text="Système prêt." HBox.hgrow="ALWAYS" styleClass="status-message" />
            <Label text="Mode hors-ligne certifié" styleClass="status-badge" />
        </HBox>
    </bottom>
</BorderPane>
