<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionnaissances.controller.MainController"
            prefHeight="800.0" prefWidth="1280.0"
            styleClass="main-container">

    <!-- ===================================================================== -->
    <!-- BARRE DE MENUS & EN-TÊTE SUPÉRIEUR                                    -->
    <!-- ===================================================================== -->
    <top>
        <VBox spacing="0">
            <!-- MenuBar standard -->
            <MenuBar styleClass="app-menubar">
                <Menu text="Fichier">
                    <MenuItem text="Nouvelle déclaration" onAction="#afficherVueFormulaire" />
                    <MenuItem text="Actualiser les données" onAction="#actualiserDonnees" />
                    <SeparatorMenuItem />
                    <MenuItem text="Fermer" onAction="#quitterApplication" />
                </Menu>
                <Menu text="Navigation">
                    <MenuItem text="Tableau de bord" onAction="#afficherVueDashboard" />
                    <MenuItem text="Enregistrer une naissance" onAction="#afficherVueFormulaire" />
                    <MenuItem text="Liste des naissances" onAction="#afficherVueListe" />
                    <MenuItem text="Recherche multicritères" onAction="#afficherVueRecherche" />
                </Menu>
                <Menu text="Base de données">
                    <MenuItem text="Vérifier la connexion SQLite" onAction="#verifierStatutBase" />
                    <MenuItem text="Statistiques SQLite" onAction="#afficherVueDashboard" />
                </Menu>
                <Menu text="Session">
                    <MenuItem text="Changer de mot de passe" onAction="#ouvrirDialogueChangementMotDePasse" />
                    <SeparatorMenuItem />
                    <MenuItem text="Se déconnecter" onAction="#seDeconnecter" />
                </Menu>
                <Menu text="Aide">
                    <MenuItem text="À propos de l'application" onAction="#afficherAPropos" />
                </Menu>
            </MenuBar>

            <!-- Bannière administrative officielle -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-banner">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20" />
                </padding>
                
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="RÉPUBLIQUE • SERVICE DE L'ÉTAT CIVIL ET DE LA POPULATION" styleClass="header-top-label" />
                    <Label fx:id="lblHeaderTitre" text="Gestion des Naissances — Registre d'État Civil" styleClass="header-title" />
                    <Label text="Conservation pérenne hors-ligne • Base SQLite locale sécurisée (naissances.db)" styleClass="header-subtitle" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="lblHeaderUtilisateur" text="Utilisateur" styleClass="header-badge-user" />
                    <Button text="＋ Nouvelle Déclaration" onAction="#afficherVueFormulaire" styleClass="btn-primary" />
                    <Button text="⟳ Actualiser" onAction="#actualiserDonnees" styleClass="btn-secondary" />
                    <Button text="🚪 Déconnexion" onAction="#seDeconnecter" styleClass="btn-secondary" />
                    <Label text="● 100% Hors-Ligne" styleClass="header-badge-offline" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ===================================================================== -->
    <!-- MENU LATÉRAL (SIDEBAR NAVIGATION)                                     -->
    <!-- ===================================================================== -->
    <left>
        <VBox spacing="0" styleClass="sidebar-pane">
            <!-- Logo communal -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-header">
                <StackPane styleClass="sidebar-logo-circle">
                    <Label text="🏛️" styleClass="sidebar-logo-text" />
                </StackPane>
                <VBox spacing="1">
                    <Label text="ÉTAT CIVIL" styleClass="sidebar-app-name" />
                    <Label text="Administration Locale" styleClass="sidebar-app-subtitle" />
                </VBox>
            </HBox>

            <!-- Navigation Links -->
            <VBox spacing="4" VBox.hgrow="ALWAYS">
                <padding><Insets top="12" right="10" bottom="12" left="10" /></padding>

                <Label text="MODULES PRINCIPAUX" styleClass="sidebar-nav-title" />

                <Button fx:id="btnNavDashboard" maxWidth="Infinity" text="📊  Tableau de bord" onAction="#afficherVueDashboard" styleClass="sidebar-btn, sidebar-btn-active" />
                <Button fx:id="btnNavNouveau" maxWidth="Infinity" text="📝  Enregistrer une naissance" onAction="#afficherVueFormulaire" styleClass="sidebar-btn" />
                <Button fx:id="btnNavListe" maxWidth="Infinity" text="📖  Liste des naissances" onAction="#afficherVueListe" styleClass="sidebar-btn" />
                <Button fx:id="btnNavRecherche" maxWidth="Infinity" text="🔍  Recherche multicritères" onAction="#afficherVueRecherche" styleClass="sidebar-btn" />
                <Button fx:id="btnNavFiche" maxWidth="Infinity" text="📄  Fiche complète enfant" onAction="#afficherVueFiche" styleClass="sidebar-btn" />

                <!-- Module Administration (Réservé au rôle ADMINISTRATEUR) -->
                <Separator style="-fx-padding: 6 0 2 0;" />
                <Label text="ADMINISTRATION" styleClass="sidebar-nav-title" />
                <Button fx:id="btnNavUtilisateurs" maxWidth="Infinity" text="👥  Gestion des utilisateurs" onAction="#afficherVueUtilisateurs" styleClass="sidebar-btn" />
            </VBox>

            <!-- Profil utilisateur connecté & Actions rapides -->
            <VBox spacing="6" styleClass="sidebar-user-card">
                <padding><Insets top="8" right="10" bottom="8" left="10" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👤" style="-fx-font-size: 18px;" />
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblSidebarNomUtilisateur" text="Utilisateur" styleClass="sidebar-user-name" />
                        <Label fx:id="lblSidebarRoleBadge" text="AGENT" styleClass="role-chip, role-chip-agent" />
                    </VBox>
                </HBox>
                <HBox spacing="4">
                    <Button fx:id="btnSidebarChangerMdp" text="🔑 Mot de passe" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#ouvrirDialogueChangementMotDePasse" styleClass="btn-sidebar-subaction" />
                    <Button fx:id="btnSidebarDeconnexion" text="🚪 Quitter" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#seDeconnecter" styleClass="btn-sidebar-subaction, btn-sidebar-logout" />
                </HBox>
            </VBox>

            <!-- Pied du menu latéral -->
            <VBox spacing="3" styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="●" style="-fx-text-fill: #10b981; -fx-font-size: 9px;" />
                    <Label text="SQLite naissances.db" styleClass="sidebar-footer-text" />
                </HBox>
                <Label text="7 tables relationnelles actives" styleClass="sidebar-footer-val" />
                <Label text="Version 1.4 • Desktop hors-ligne" styleClass="sidebar-footer-text" />
            </VBox>
        </VBox>
    </left>

    <!-- ===================================================================== -->
    <!-- ZONE CENTRALE DYNAMIQUE (STACKPANE DES 5 VUES)                        -->
    <!-- ===================================================================== -->
    <center>
        <StackPane fx:id="mainContentStack" styleClass="content-area">

            <!-- ============================================================= -->
            <!-- 1. VUE : TABLEAU DE BORD (DASHBOARD)                          -->
            <!-- ============================================================= -->
            <VBox fx:id="viewDashboard" spacing="16">
                <padding><Insets top="16" right="20" bottom="16" left="20" /></padding>

                <!-- Titre de la vue -->
                <VBox spacing="2">
                    <Label text="Tableau de Bord de l'État Civil" styleClass="view-title" />
                    <Label text="Vue d'ensemble statistique des naissances enregistrées dans la commune" styleClass="view-subtitle" />
                </VBox>

                <!-- 4 Cartes KPI -->
                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <!-- KPI 1 : Total Naissances -->
                    <VBox spacing="4" GridPane.columnIndex="0" styleClass="kpi-card, kpi-card-blue">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📜" style="-fx-font-size: 16px;" />
                            <Label text="TOTAL NAISSANCES" styleClass="kpi-label" />
                        </HBox>
                        <Label fx:id="lblKpiTotal" text="0" styleClass="kpi-value" />
                        <Label text="Actes inscrits au registre" styleClass="kpi-sub" />
                    </VBox>

                    <!-- KPI 2 : Garçons -->
                    <VBox spacing="4" GridPane.columnIndex="1" styleClass="kpi-card, kpi-card-blue">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👦" style="-fx-font-size: 16px;" />
                            <Label text="GARÇONS (M)" styleClass="kpi-label" />
                        </HBox>
                        <Label fx:id="lblKpiGarcons" text="0" styleClass="kpi-value" />
                        <Label text="Nouveau-nés masculins" styleClass="kpi-sub" />
                    </VBox>

                    <!-- KPI 3 : Filles -->
                    <VBox spacing="4" GridPane.columnIndex="2" styleClass="kpi-card, kpi-card-pink">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👧" style="-fx-font-size: 16px;" />
                            <Label text="FILLES (F)" styleClass="kpi-label" />
                        </HBox>
                        <Label fx:id="lblKpiFilles" text="0" styleClass="kpi-value" />
                        <Label text="Nouveau-nés féminins" styleClass="kpi-sub" />
                    </VBox>

                    <!-- KPI 4 : Année en cours -->
                    <VBox spacing="4" GridPane.columnIndex="3" styleClass="kpi-card, kpi-card-green">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📅" style="-fx-font-size: 16px;" />
                            <Label fx:id="lblKpiAnneeTitre" text="ANNÉE EN COURS" styleClass="kpi-label" />
                        </HBox>
                        <Label fx:id="lblKpiAnnee" text="0" styleClass="kpi-value" />
                        <Label text="Déclarations enregistrées" styleClass="kpi-sub" />
                    </VBox>
                </GridPane>

                <!-- Section Graphique & Actions Rapides -->
                <HBox spacing="14" VBox.hgrow="ALWAYS">
                    <!-- Graphique par Année -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="form-card">
                        <Label text="Évolution des Enregistrements par Année" styleClass="form-card-title" />
                        <BarChart fx:id="chartNaissancesParAnnee" legendVisible="false" VBox.hgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis fx:id="chartAxisX" label="Année" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="chartAxisY" label="Nombre d'actes" />
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Raccourcis d'actions rapides -->
                    <VBox spacing="10" prefWidth="280" styleClass="form-card">
                        <Label text="Actions Rapides" styleClass="form-card-title" />
                        <Button maxWidth="Infinity" text="📝  Nouvelle Déclaration" onAction="#afficherVueFormulaire" styleClass="btn-primary" />
                        <Button maxWidth="Infinity" text="🔍  Recherche par Identifiant" onAction="#afficherVueRecherche" styleClass="btn-secondary" />
                        <Button maxWidth="Infinity" text="📖  Ouvrir le Registre Général" onAction="#afficherVueListe" styleClass="btn-secondary" />
                        <Separator />
                        <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 4; -fx-border-color: #e2e8f0;">
                            <Label text="Norme d'identifiant communal :" styleClass="field-label" />
                            <Label text="CIV-COMM-AAAA-XXXXX" style="-fx-font-family: Consolas; -fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-font-size: 11px;" />
                            <Label text="Calcul automatique de l'âge des parents et intégrité relationnelle SQLite assurée." style="-fx-font-size: 10px; -fx-text-fill: #64748b;" wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Tableau récapitulatif des derniers dossiers -->
                <VBox spacing="6" prefHeight="220" styleClass="form-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Derniers Dossiers Enregistrés" styleClass="form-card-title" HBox.hgrow="ALWAYS" />
                        <Button text="Voir tous les dossiers →" onAction="#afficherVueListe" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 8 4 8;" />
                    </HBox>
                    <TableView fx:id="tableDerniersDossiers" VBox.hgrow="ALWAYS" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="colDashIdentifiant" text="Identifiant unique communal" prefWidth="180" />
                            <TableColumn fx:id="colDashNumeroRegistre" text="N° Registre" prefWidth="130" />
                            <TableColumn fx:id="colDashNomPrenoms" text="Nom et Prénoms de l'Enfant" prefWidth="240" />
                            <TableColumn fx:id="colDashSexe" text="Sexe" prefWidth="60" />
                            <TableColumn fx:id="colDashDateNaiss" text="Date Naissance" prefWidth="110" />
                            <TableColumn fx:id="colDashLieu" text="Lieu de Naissance" prefWidth="180" />
                            <TableColumn fx:id="colDashMere" text="Mère" prefWidth="160" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ============================================================= -->
            <!-- 2. VUE : ENREGISTRER UNE NAISSANCE (FORMULAIRE COMPLET)       -->
            <!-- ============================================================= -->
            <VBox fx:id="viewFormulaire" spacing="0" visible="false">
                <!-- En-tête formulaire -->
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="view-header">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Enregistrement d'un Dossier de Naissance" styleClass="view-title" />
                        <Label text="Saisie officielle et complète du registre des naissances (7 tables relationnelles SQLite)" styleClass="view-subtitle" />
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Effacer / Réinitialiser" onAction="#reinitialiserFormulaireComplet" styleClass="btn-secondary" />
                        <Button text="💾 Enregistrer dans SQLite" onAction="#enregistrerDossierComplet" styleClass="btn-primary" />
                    </HBox>
                </HBox>

                <!-- ScrollPane contenant toutes les sections -->
                <ScrollPane fitToWidth="true" VBox.hgrow="ALWAYS" styleClass="form-scroll">
                    <VBox spacing="14">
                        <padding><Insets top="16" right="24" bottom="24" left="24" /></padding>

                        <!-- Section 1 : Références Administratives de l'Acte -->
                        <VBox spacing="8" styleClass="form-card">
                            <Label text="1. Références Administratives de l'Acte Communal" styleClass="form-card-title" />
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30" />
                                    <ColumnConstraints percentWidth="25" />
                                    <ColumnConstraints percentWidth="15" />
                                    <ColumnConstraints percentWidth="15" />
                                    <ColumnConstraints percentWidth="15" />
                                </columnConstraints>

                                <VBox spacing="4" GridPane.columnIndex="0">
                                    <Label text="Identifiant unique communal *" styleClass="field-label-gold" />
                                    <HBox spacing="6">
                                        <TextField fx:id="txtFormIdentifiantUnique" promptText="CIV-COMM-2025-00001" styleClass="text-input-readonly" HBox.hgrow="ALWAYS" />
                                        <Button text="⚡" onAction="#genererNouvelIdentifiant" title="Régénérer" styleClass="btn-secondary" style="-fx-padding: 6 10 6 10;" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1">
                                    <Label text="Numéro de Registre *" styleClass="field-label-required" />
                                    <TextField fx:id="txtFormNumeroRegistre" promptText="REG-2025-0001" styleClass="text-input" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="2">
                                    <Label text="Année Registre *" styleClass="field-label-required" />
                                    <TextField fx:id="txtFormAnneeRegistre" promptText="2025" styleClass="text-input" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="3">
                                    <Label text="Folio" styleClass="field-label" />
                                    <TextField fx:id="txtFormFolio" promptText="F-01" styleClass="text-input" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="4">
                                    <Label text="Tome" styleClass="field-label" />
                                    <TextField fx:id="txtFormTome" promptText="T-01" styleClass="text-input" />
                                </VBox>
                            </GridPane>

                            <GridPane hgap="12" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <VBox spacing="4" GridPane.columnIndex="0">
                                    <Label text="Date de déclaration *" styleClass="field-label-required" />
                                    <DatePicker fx:id="dpFormDateDeclaration" maxWidth="Infinity" styleClass="date-picker-custom" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1">
                                    <Label text="Heure de déclaration" styleClass="field-label" />
                                    <TextField fx:id="txtFormHeureDeclaration" promptText="10:30" styleClass="text-input" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- Section 2 : Identité du Nouveau-né -->
                        <VBox spacing="8" styleClass="form-card">
                            <Label text="2. Identité de l'Enfant (Nouveau-né)" styleClass="form-card-title" />
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Nom de famille de l'enfant *" styleClass="field-label-required" />
                                    <TextField fx:id="txtFormNomEnfant" promptText="ex: KOUASSI" styleClass="text-input" style="-fx-font-weight: bold;" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Prénoms de l'enfant *" styleClass="field-label-required" />
                                    <TextField fx:id="txtFormPrenomsEnfant" promptText="ex: Emmanuel Koffi" styleClass="text-input" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Sexe *" styleClass="field-label-required" />
                                    <ComboBox fx:id="cbFormSexe" maxWidth="Infinity" styleClass="combo-box-custom" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Statut légal de l'enfant" styleClass="field-label" />
                                    <ComboBox fx:id="cbFormStatutEnfant" maxWidth="Infinity" styleClass="combo-box-custom" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Date de naissance *" styleClass="field-label-required" />
                                    <DatePicker fx:id="dpFormDateNaissance" maxWidth="Infinity" styleClass="date-picker-custom" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Heure de naissance" styleClass="field-label" />
                                    <TextField fx:id="txtFormHeureNaissance" promptText="08:45" styleClass="text-input" />
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                    <Label text="Lieu de naissance (Maternité, Hôpital, Commune) *" styleClass="field-label-required" />
                                    <TextField fx:id="txtFormLieuNaissance" promptText="ex: Centre Hospitalier Régional, Maternité Municipale" styleClass="text-input" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- Section 3 : Filiation des Parents -->
                        <VBox spacing="8" styleClass="form-card">
                            <Label text="3. Filiation des Parents (Père et Mère)" styleClass="form-card-title" />
                            
                            <!-- Père -->
                            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                <Label text="— Informations du Père" styleClass="subsection-title" />
                                <GridPane hgap="10" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="30" />
                                        <ColumnConstraints percentWidth="30" />
                                        <ColumnConstraints percentWidth="20" />
                                        <ColumnConstraints percentWidth="20" />
                                    </columnConstraints>
                                    <VBox spacing="4" GridPane.columnIndex="0">
                                        <Label text="Nom du père" styleClass="field-label" />
                                        <TextField fx:id="txtFormNomPere" promptText="Nom" styleClass="text-input" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="1">
                                        <Label text="Prénoms du père" styleClass="field-label" />
                                        <TextField fx:id="txtFormPrenomPere" promptText="Prénoms" styleClass="text-input" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="2">
                                        <Label text="Date de naissance père" styleClass="field-label" />
                                        <DatePicker fx:id="dpFormDateNaissPere" maxWidth="Infinity" styleClass="date-picker-custom" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="3">
                                        <Label text="Âge calculé" styleClass="field-label" />
                                        <TextField fx:id="txtFormAgePere" promptText="Âge (ans)" styleClass="text-input-readonly" />
                                    </VBox>
                                </GridPane>
                                <GridPane hgap="10" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>
                                    <VBox spacing="4" GridPane.columnIndex="0">
                                        <Label text="Profession du père" styleClass="field-label" />
                                        <TextField fx:id="txtFormProfessionPere" promptText="Profession" styleClass="text-input" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="1">
                                        <Label text="Domicile / Résidence du père" styleClass="field-label" />
                                        <TextField fx:id="txtFormDomicilePere" promptText="Ville ou quartier de résidence" styleClass="text-input" />
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <!-- Mère -->
                            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                <Label text="— Informations de la Mère" styleClass="subsection-title" />
                                <GridPane hgap="10" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="30" />
                                        <ColumnConstraints percentWidth="30" />
                                        <ColumnConstraints percentWidth="20" />
                                        <ColumnConstraints percentWidth="20" />
                                    </columnConstraints>
                                    <VBox spacing="4" GridPane.columnIndex="0">
                                        <Label text="Nom de famille de la mère *" styleClass="field-label-required" />
                                        <TextField fx:id="txtFormNomMere" promptText="Nom de jeune fille" styleClass="text-input" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="1">
                                        <Label text="Prénoms de la mère *" styleClass="field-label-required" />
                                        <TextField fx:id="txtFormPrenomMere" promptText="Prénoms" styleClass="text-input" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="2">
                                        <Label text="Date de naissance mère" styleClass="field-label" />
                                        <DatePicker fx:id="dpFormDateNaissMere" maxWidth="Infinity" styleClass="date-picker-custom" />
                                    </VBox>
                                    <VBox spacing="4" GridPane.columnIndex="3">
                                        <Label text="Âge calculé" styleClass="field-label" />
                                        <TextField fx:id="txtFormAgeMere" promptText="Âge (ans)" styleClass="text-input-readonly" />
                                    </VBox>
                                </GridPane>
                                <GridPane hgap="10" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>
                                    <VBox spacing="4" GridPane.columnIndex="0">
                                        <Label text="Profession de la mère" styleClass="field-label" />
